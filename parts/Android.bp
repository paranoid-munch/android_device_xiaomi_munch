android_app {
    name: "XiaomiParts",

    srcs: [
        "src/**/*.kt",
        "src/**/*.java"
    ],

    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    static_libs: [
        "co.aospa.resources",
        "SettingsLib",
        "androidx.core_core",
        "androidx.preference_preference",
        "androidx.appcompat_appcompat",
    ],

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },

    required: [
        "privapp_whitelist_co.aospa.settings.xml",
    ],
}

prebuilt_etc {
    name: "privapp_whitelist_co.aospa.settings.xml",
    src: "permissions/privapp_whitelist_co.aospa.settings.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
