# FPS Info
allow system_app vendor_sysfs_graphics:file { getattr open read };

allow system_app proc_stat:file r_file_perms;

allow system_app sysfs_devices_system_cpu:file r_file_perms;
allow system_app sysfs_thermal:file r_file_perms;

allow system_app vendor_sysfs_kgsl:file r_file_perms;
allow system_app vendor_sysfs_kgsl:dir r_dir_perms;

allow system_app vendor_sysfs_kgsl_gpuclk:file r_file_perms;

allow system_app vendor_sysfs_kgsl_gpu_model:file r_file_perms;

